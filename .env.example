# Copy this file to .env and edit it for each installation.
# docker-compose reads it automatically. Never commit the real .env.

# REQUIRED: a long random secret used to sign login tokens. The app refuses to
# start without it (>= 16 chars) and also refuses this example placeholder, so
# you MUST replace it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Local development only: you may set RAG_ALLOW_INSECURE_DEV_KEY=1 to skip this.
RAG_SECRET_KEY=change-me-to-a-long-random-string

# First-boot admin user. If RAG_ADMIN_PASSWORD is left EMPTY (recommended for
# interactive installs), the UI shows a one-time setup wizard on first run where
# you enter your company name + admin account - after that it is sign-in only.
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=

# PostgreSQL database (production). When empty, SQLite is used (dev/tests).
# Format: postgresql://user:password@host:port/dbname
RAG_DATABASE_URL=postgresql://rag:rag@postgres:5432/rag
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

# LLM backend:
#   transformers  -> in-process Hugging Face model (default; works on any CPU)
#   openai        -> Ollama (docker-compose.ollama.yml) or vLLM (docker-compose.vllm.yml)
RAG_LLM_BACKEND=transformers
RAG_LLM_BASE_URL=http://ollama:11434
RAG_LLM_MODEL=google/flan-t5-base

# How many tenants' FAISS indexes stay loaded in memory at once (LRU eviction).
RAG_PIPELINE_CACHE_SIZE=8

# Sliding-window rate limit on the /query endpoint, per authenticated caller.
RAG_QUERY_RATE_LIMIT_MAX=30
RAG_QUERY_RATE_LIMIT_WINDOW_SECONDS=60

# PBKDF2-HMAC-SHA256 cost factor for NEW password hashes (OWASP: >= 600k).
RAG_PBKDF2_ITERATIONS=600000

# Hard cap on a single uploaded document (MiB).
RAG_MAX_UPLOAD_MB=50

# Hallucination guardrail.
RAG_GROUNDING_CHECK=1
RAG_GROUNDING_MIN_OVERLAP=0.5
RAG_GROUNDING_MIN_TOKENS=4

# Admin/auth actions audit log retention.
RAG_AUDIT_LOG_RETENTION_DAYS=365

# Login token time-to-live in seconds (default 43200 = 12 hours).
RAG_TOKEN_TTL_SECONDS=43200

# Brute-force protection.
RAG_LOGIN_MAX_FAILURES=5
RAG_LOGIN_MAX_FAILURES_PER_IP=20
RAG_LOGIN_FAILURE_WINDOW_SECONDS=900

# CORS: comma-separated list of allowed origins. Leave empty for all (dev).
RAG_CORS_ORIGINS=

# Global per-IP rate limit on ALL requests (default 120/min).
RAG_GLOBAL_RATE_LIMIT_MAX=120

# SSO / OIDC (optional). Set RAG_SSO_ENABLED=1 to enable.
RAG_SSO_ENABLED=
RAG_SSO_PROVIDER=oidc
RAG_SSO_DEFAULT_TENANT=default
RAG_OIDC_ISSUER_URL=
RAG_OIDC_CLIENT_ID=
RAG_OIDC_CLIENT_SECRET=
RAG_OIDC_REDIRECT_URI=http://localhost:8000/auth/sso/callback

# LDAP (optional, for enterprise directory integration).
RAG_LDAP_SERVER_URL=ldap://ldap:389
RAG_LDAP_BIND_DN=
RAG_LDAP_BIND_PASSWORD=
RAG_LDAP_USER_SEARCH_BASE=
RAG_LDAP_USER_SEARCH_FILTER=(uid={username})

# At-rest document encryption (optional). Set to a long random string to enable.
# When empty, documents are stored plaintext.
RAG_ENCRYPTION_KEY=

# Storage locations (optional).
RAG_DATA_DIR=
RAG_DB_PATH=

# Used by the vLLM profile for gated model repos (optional).
HF_TOKEN=
