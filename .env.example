# Copy this file to .env and edit it for each installation.
# docker-compose reads it automatically. Never commit the real .env.

# REQUIRED: a long random secret used to sign login tokens. The app refuses to
# start without it (>= 16 chars) and also refuses this example placeholder, so
# you MUST replace it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Local development only: you may set RAG_ALLOW_INSECURE_DEV_KEY=1 to skip this.
RAG_SECRET_KEY=change-me-to-a-long-random-string

# First-boot admin user. If RAG_ADMIN_PASSWORD is left EMPTY (recommended for
# interactive installs), the UI shows a one-time setup wizard on first run where
# you enter your company name + admin account - after that it is sign-in only.
# If you DO set a password here, the wizard is skipped and `admin` is auto-seeded.
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=

# LLM backend:
#   transformers  -> in-process Hugging Face model (default; works on any CPU)
#   openai        -> Ollama (docker-compose.ollama.yml) or vLLM (docker-compose.vllm.yml)
RAG_LLM_BACKEND=transformers
RAG_LLM_BASE_URL=http://ollama:11434
RAG_LLM_MODEL=google/flan-t5-base

# How many tenants' FAISS indexes stay loaded in memory at once (LRU eviction).
# Raise it on machines with lots of RAM and many active tenants.
RAG_PIPELINE_CACHE_SIZE=8

# Sliding-window rate limit on the /query endpoint (the expensive LLM+FAISS
# path), per authenticated caller (user or API key). Raise for high-usage teams.
RAG_QUERY_RATE_LIMIT_MAX=30
RAG_QUERY_RATE_LIMIT_WINDOW_SECONDS=60

# PBKDF2-HMAC-SHA256 cost factor for NEW password hashes (OWASP: >= 600k).
# Existing hashes keep their own iteration count and are transparently rehashed
# on the next successful login, so raising this never breaks accounts.
RAG_PBKDF2_ITERATIONS=600000

# Hard cap on a single uploaded document (MiB). Exceeding it returns 413 and
# leaves no partial file behind. Guards against filling the disk with a
# runaway upload.
RAG_MAX_UPLOAD_MB=50

# Hallucination guardrail: after the LLM answers, at least GROUNDING_MIN_OVERLAP
# of the answer's content words must appear in the retrieved context, or the
# answer is replaced with "I don't know." Short answers and abstentions always
# pass (GROUNDING_MIN_TOKENS is the minimum answer length before the check
# kicks in). Set RAG_GROUNDING_CHECK=0 only to disable this safeguard.
RAG_GROUNDING_CHECK=1
RAG_GROUNDING_MIN_OVERLAP=0.5
RAG_GROUNDING_MIN_TOKENS=4

# Admin/auth actions (setup, logins, password changes, user/API-key/tenant
# management, uploads) are written to an append-only audit log. Rows older
# than this retention window are pruned opportunistically on insert.
RAG_AUDIT_LOG_RETENTION_DAYS=365

# Brute-force protection: per-username lockout threshold, per-source-IP
# throttle threshold, and the rolling window length in seconds. A successful
# login clears that account's failure history.
RAG_LOGIN_MAX_FAILURES=5
RAG_LOGIN_MAX_FAILURES_PER_IP=20
RAG_LOGIN_FAILURE_WINDOW_SECONDS=900

# Storage locations (optional). RAG_DATA_DIR relocates the whole data folder
# (tenants/, system.db) - e.g. to a mounted volume or separate disk.
# RAG_DB_PATH overrides just the SQLite auth database. Defaults are below.
RAG_DATA_DIR=
RAG_DB_PATH=

# Used by the vLLM profile for gated model repos (optional).
HF_TOKEN=

